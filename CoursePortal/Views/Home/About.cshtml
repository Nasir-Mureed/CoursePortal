@page


<style>
    .about-hero {
        background: linear-gradient(135deg, #155eef, #063da8);
        color: white;
        padding: 75px 20px;
        text-align: center;
    }

    .about-section {
        padding: 65px 0;
    }

    .about-card {
        border: none;
        border-radius: 14px;
        padding: 30px 20px;
        height: 100%;
        box-shadow: 0 5px 25px rgba(0,0,0,0.06);
        transition: 0.3s;
    }

    .about-card:hover {
        transform: translateY(-5px);
    }

    .about-icon {
        font-size: 38px;
        margin-bottom: 15px;
    }

    .about-text {
        color: #667085;
        line-height: 1.8;
    }

    .tech-badge {
        background: #edf3ff;
        color: #155eef;
        padding: 10px 18px;
        border-radius: 8px;
        display: inline-block;
        margin: 6px;
        font-weight: 600;
    }
</style>

<!-- Hero Section -->
<section class="about-hero">
    <div class="container">
        <h1 class="display-4 fw-bold">About CoursePortal</h1>
        <p class="lead mt-3">
            Simplifying course management, empowering students.
        </p>
    </div>
</section>

<!-- Introduction -->
<section class="about-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-md-6">
                <h2 class="fw-bold mb-3">What is CoursePortal?</h2>

                <p class="about-text">
                    CoursePortal is a web-based Student Course Management
                    System designed to make academic management easier
                    and more organized.
                </p>

                <p class="about-text">
                    It provides administrators with tools to manage
                    students, courses, and enrollments, while students
                    can explore available courses and manage their
                    own enrollments through a simple interface.
                </p>
            </div>

            <div class="col-md-6">
                <div class="bg-light rounded-4 p-5 text-center">
                    <div style="font-size: 85px;">🎓</div>
                    <h3 class="fw-bold text-primary mt-3">CoursePortal</h3>
                    <p class="text-muted mb-0">
                        Learn. Manage. Grow.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Mission and Vision -->
<section class="bg-light about-section">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">Our Mission & Vision</h2>
            <p class="about-text">
                Making academic course management simple and accessible.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="about-card text-center bg-white">
                    <h4 class="fw-bold">Our Mission</h4>
                    <p class="about-text">
                        To provide an organized platform that reduces
                        manual academic work and simplifies student
                        and course management.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="about-card text-center bg-white">
                    <h4 class="fw-bold">Our Vision</h4>
                    <p class="about-text">
                        To create a user-friendly academic environment
                        where administrators and students can manage
                        their activities efficiently.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Features -->
<section class="about-section">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">What We Offer</h2>
            <p class="about-text">
                Everything needed for basic course management.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="about-card text-center">
                    <div class="about-icon">👨‍🎓</div>
                    <h5 class="fw-bold">Student Management</h5>
                    <p class="about-text">
                        Manage student profiles and academic information.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-card text-center">
                    <div class="about-icon">📚</div>
                    <h5 class="fw-bold">Course Management</h5>
                    <p class="about-text">
                        Organize courses and maintain course details.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-card text-center">
                    <div class="about-icon">📝</div>
                    <h5 class="fw-bold">Easy Enrollment</h5>
                    <p class="about-text">
                        Allow students to browse and enroll in courses.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Technologies -->
<section class="bg-light about-section">
    <div class="container text-center">

        <h2 class="fw-bold mb-3">Technologies We Use</h2>

        <p class="about-text mb-4">
            CoursePortal is built using modern web development technologies.
        </p>

        <div>
            <span class="tech-badge">ASP.NET Core</span>
            <span class="tech-badge">C#</span>
            <span class="tech-badge">Entity Framework</span>
            <span class="tech-badge">SQL Server</span>
            <span class="tech-badge">Bootstrap 5</span>
            <span class="tech-badge">HTML & CSS</span>
        </div>

    </div>
</section>

<!-- CTA -->
<section class="about-section text-center">
    <div class="container">
        <h2 class="fw-bold">Ready to Get Started?</h2>

        <p class="about-text">
            Join CoursePortal and simplify your academic experience.
        </p>

        <a asp-area="Identity"
           asp-page="/Account/Register"
           class="btn btn-primary btn-lg px-4 mt-3">
            Create Your Account
        </a>
    </div>
</section>
