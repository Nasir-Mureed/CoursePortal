@model CoursePortal.Models.ViewModels.StudentHomeViewModel
@{
    ViewData["Title"] = "Student Home";
}

<section class="bg-light py-4">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-2">
                    Student Dashboard
                </span>
                <h1 class="fw-bold mb-1">
                    Welcome@(Model.Student != null ? $", {Model.Student.FirstName}" : "")
                </h1>
                <p class="text-secondary mb-0">Browse courses and manage your enrollments.</p>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-5">
        <div class="col-md-6">
            <div class="bg-light rounded-4 p-4 border">
                <small class="text-secondary">My Enrollments</small>
                <h2 class="fw-bold mt-2 mb-0">@Model.MyEnrollments.Count()</h2>
            </div>
        </div>
        <div class="col-md-6">
            <div class="bg-light rounded-4 p-4 border">
                <small class="text-secondary">Available Courses</small>
                <h2 class="fw-bold mt-2 mb-0">@Model.AvailableCourses.Count()</h2>
            </div>
        </div>
    </div>

    <!-- My enrollments -->
    <div class="mb-5">
        <h3 class="fw-bold mb-3">My Enrollments</h3>
        @if (!Model.MyEnrollments.Any())
        {
            <div class="card border shadow-sm rounded-4">
                <div class="card-body p-4 text-secondary">
                    You are not enrolled in any courses yet.
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model.MyEnrollments)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-success-subtle text-success">@item.Status</span>
                                    <small class="text-secondary">@item.CourseCode</small>
                                </div>
                                <h5 class="fw-bold mb-1">@item.CourseName</h5>
                                <p class="text-secondary small mb-0">@item.Category</p>
                                <p class="text-secondary small mb-0 mt-2">
                                    Enrolled @item.EnrollmentDate.ToString("MMM dd, yyyy")
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Available courses -->
    <div>
        <h3 class="fw-bold mb-3">Available Courses</h3>
        @if (!Model.AvailableCourses.Any())
        {
            <div class="card border shadow-sm rounded-4">
                <div class="card-body p-4 text-secondary">
                    No more courses available to enroll.
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var course in Model.AvailableCourses)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 border shadow-sm rounded-4">
                            <div class="card-body p-4 d-flex flex-column">
                                <span class="badge bg-primary-subtle text-primary mb-3 align-self-start">
                                    @course.Category
                                </span>
                                <h5 class="fw-bold mb-1">@course.CourseName</h5>
                                <p class="text-secondary small mb-2">
                                    @course.CourseCode · @course.Credits credits · @course.Duration
                                </p>
                                <p class="text-secondary flex-grow-1">@course.Description</p>

                                <form asp-action="Enroll" method="post" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="courseId" value="@course.CourseId"/>
                                    <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold">
                                        Enroll
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
