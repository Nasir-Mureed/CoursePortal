<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - CoursePortal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/CoursePortal.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
<!-- ================= NAVBAR ================= -->

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">
    <div class="container">

        <!-- Brand -->
        <a class="navbar-brand fw-bold fs-3 text-primary"
           asp-page="/Index">
            Course<span class="text-dark">Portal</span>
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="mainNavbar">

            <!-- Navigation Links -->
            <ul class="navbar-nav mx-auto gap-lg-3">

                <li class="nav-item">
                    <a class="nav-link fw-semibold text-dark"
                       asp-page="/Index">
                        Home
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link fw-semibold text-dark"
                       asp-action="About">
                        About
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link fw-semibold text-dark"
                       asp-action="Privacy">
                        Privacy
                    </a>
                </li>

               

            </ul>

            <!-- Authentication Buttons -->
            <div class="d-flex flex-column flex-lg-row gap-2 mt-3 mt-lg-0">

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-outline-primary px-4 fw-semibold">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-primary px-4 fw-semibold">
                    Get Started
                </a>

            </div>

        </div>
    </div>
</nav>

</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - CoursePortal - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>